generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Currency {
  USD
  EUR
  GBP
  PLN
}

enum ReservationStatus {
  ACTIVE
  RELEASED
}

model Program {
  id             String        @id @default(cuid())
  name           String
  currency       Currency
  totalLimit     Int           // w minor units (cents)
  reservedAmount Int           @default(0) // w minor units (cents)
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  reservations   Reservation[]
}

model Reservation {
  id         String            @id @default(cuid())
  programId  String
  invoiceId  String            
  amount     Int               // w minor units (cents)
  currency   Currency
  status     ReservationStatus @default(ACTIVE)
  createdAt  DateTime          @default(now())
  releasedAt DateTime?

  program    Program           @relation(fields: [programId], references: [id])

  @@index([programId, invoiceId])
}

model ReconciliationSnapshot {
  id             String   @id @default(cuid())
  programId      String
  totalLimit     Int
  reservedAmount Int
  currency       Currency
  version        Int      
  timestamp      DateTime
  createdAt      DateTime @default(now())
}
